{
  "name": "llm-lab-root",
  "version": "1.0.0",
  "private": true,
  "description": "LLM Lab — Educational platform for experimenting with Large Language Models",
  "scripts": {
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" --kill-others \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "typecheck": "concurrently -n \"TC-BACKEND,TC-FRONTEND\" -c \"blue,green\" \"npm run typecheck:backend\" \"npm run typecheck:frontend\"",
    "typecheck:backend": "npm --prefix backend run typecheck",
    "typecheck:frontend": "npm --prefix frontend run typecheck",
    "test": "npm --prefix backend test",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
